           <widget class="QCheckBox" name="checkBox">
            <property name="styleSheet">
             <string notr="true">QCheckBox {    
	spacing: 8px;
    color: #8892a6;
    font-size: 13px;
    font-weight: 500;
    background-color:  transparent;
    border: 1px solid #353849; 
    border-radius: 10px;
    padding: 5px 10px;
}

QCheckBox::indicator {
    width: 40px;
    height: 20px;
    border-radius: 10px;
}

QCheckBox::indicator:unchecked {
    background-color: #353849;
    image: url(:/icons/ui/icons/toggle-left-gray.svg);
}

QCheckBox::indicator:checked {
    background-color: #5b7cff;
    image: url(:/icons/ui/icons/toggle-right-white.svg);
}

QCheckBox:hover {
    background-color: #1f2433;
    color: #e8eaed;
}</string>

  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #1a1d2e;
}

QWidget {
    background-color: #1a1d2e;
    color: #e8eaed;
    font-family: 'Segoe UI', 'Inter', Arial, sans-serif;
    font-size: 13px;
}

QPushButton {
    background-color: #5b7cff;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #6b8cff;
}

QPushButton:pressed {
    background-color: #4a6bde;
}

QPushButton#editButton, QPushButton#playButton {
    padding: 8px 24px;
    font-size: 14px;
}

QPushButton#playButton {
    background-color: transparent;
    color: #8892a6;
}

QPushButton#playButton:hover {
    background-color: #282d42;
    color: #e8eaed;
}

QLabel {
    color: #e8eaed;
    font-size: 13px;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #252936;
    color: #e8eaed;
    border: 1px solid #353849;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1px solid #5b7cff;
    background-color: #2a2f42;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {
    width: 0px;
}

QSlider::groove:horizontal {
    background: #353849;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: white;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::sub-page:horizontal {
    background: #5b7cff;
    border-radius: 2px;
}

QGroupBox {
    color: #e8eaed;
    border: none;
    margin-top: 20px;
    font-weight: 600;
    font-size: 13px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 0 8px 0;
    color: #8892a6;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #8892a6;
    margin-right: 8px;
}</string>
  </property>
